# Supabase (AI Agent Hub project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (GHL Token project - read-only)
GHL_TOKEN_SUPABASE_URL=
GHL_TOKEN_SUPABASE_SERVICE_KEY=

# GoHighLevel
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_API_BASE=https://services.leadconnectorhq.com

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude) — opcional, habilita modelos Claude no seletor
ANTHROPIC_API_KEY=

# Auth
JWT_SECRET=

# Cron
CRON_SECRET=

# Dev bypass (SOMENTE em ambientes de dev/teste — NUNCA em produção)
# Exige AMBAS as flags + NODE_ENV != production pra ativar a rota /api/auth/dev-login.
# NEXT_PUBLIC_DEV_MODE faz o botão aparecer na UI.
# DEV_MODE (server-only, não vaza pro bundle) autoriza o endpoint.
NEXT_PUBLIC_DEV_MODE=
DEV_MODE=

# Webhook — quando "true", rejeita qualquer inbound sem GHL_WEBHOOK_SECRET configurado.
# Use em produção pra bloquear spoofing de webhooks.
WEBHOOK_REQUIRE_SIGNATURE=
GHL_WEBHOOK_SECRET=

# Sentry — monitoramento de erros (OPCIONAL). Sem DSN o Sentry fica 100% inativo:
# o build e o runtime seguem idênticos. Pra ativar: crie um projeto Next.js em
# sentry.io (free tier) e cole o DSN abaixo no painel do Vercel.
NEXT_PUBLIC_SENTRY_DSN=
# Server-side (opcional): se não setar, server/edge caem pra NEXT_PUBLIC acima.
# Vantagem de setar: o DSN do server não vai pro bundle do browser.
SENTRY_DSN=
# Org/project slug + auth token: necessários SÓ pra subir source maps no build
# (stack traces legíveis). Opcionais — sem eles o Sentry ainda captura erros.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Amostragem de tracing (0 a 1). Default 0.1. Deixe baixo pra economizar quota.
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Ponte Sentry → painel de Signals do hub (admin_signals). ON por padrão, mas só
# atua em produção (VERCEL_ENV=production). Defina "0" pra desligar de vez (crash
# deixa de virar signal, segue indo só pro Sentry).
SENTRY_SIGNALS_BRIDGE=

# Prospecção 2.0 (Pedro 2026-05-28): 3 runners do cron sparkbot-proactive.
# Default OFF — só rodam quando admin ligar após smoke supervisionado.
#
# OUTREACH_RUNNER_ENABLED=1: cron varre agents com outreach_config.enabled,
#   respeita cooldown 24h, cria bulk_message_jobs em status='paused' (admin
#   ativa via UI).
#
# BULK_SEQUENCES_ENABLED=1: sequence-runner avança bulk_message_sequence_state
#   quando next_send_at vence; cria recipient pro próximo step com
#   message_template_override do step.
#
# RECURRING_CAMPAIGNS_ENABLED=1: recurring-runner processa recurring_campaigns
#   enabled+vencidas, cria job filho 'running' + popula recipients + atualiza
#   next_run_at via cron_expression no timezone do agente.
OUTREACH_RUNNER_ENABLED=
BULK_SEQUENCES_ENABLED=
RECURRING_CAMPAIGNS_ENABLED=

# Auto-drain da wallet (Pedro 2026-07-27) — Default OFF.
# Deadlock: o auto-recharge do HighLevel só dispara quando o saldo cruza o
# limiar ($0), mas quando a cobrança excede o saldo o GHL rejeita INTEIRA e o
# saldo fica preso num residual (ex: $0,04) que nunca cruza $0 → recharge nunca
# dispara → wallet encalha, IA bloqueada até recarga manual.
#
# WALLET_AUTO_DRAIN_ENABLED=1: no cron de retry, quando a cobrança falha por
#   saldo, DRENA o residual em microcobranças descendentes até zerar a wallet →
#   o auto-recharge do HL dispara (+$10) → refaz a cobrança real. ≤1 dreno por
#   episódio (CAS) e por run; teto de dreno WALLET_DRAIN_MAX_USD; deadline 20s.
#   ⚠️ VALIDAR ANTES: rodar `npx tsx scripts/probe-wallet-drain.ts <LOC> --yes`
#   numa conta sua pra confirmar que zerar dispara o recharge no seu HL.
# WALLET_DRAIN_STEPS: denominações do dreno (default "0.10,0.05,0.02,0.01").
# WALLET_DRAIN_MAX_USD: teto de dreno por episódio em USD (default 0.50).
WALLET_AUTO_DRAIN_ENABLED=
WALLET_DRAIN_STEPS=
WALLET_DRAIN_MAX_USD=
